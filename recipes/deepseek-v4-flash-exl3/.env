# Local pins for the tpurtell EXL3-K2 recipe (untracked; survives upstream pulls).
#
# All three MUST be set explicitly: compose.yaml passes them through with
# `${VAR:-}`, and an empty CUTE_DSL_ARCH crashes the CUTE DSL MLA kernel
# compile (KeyError: '') -- forum thread 379863, known issue #1.
CUTE_DSL_ARCH=sm_121a

# 0.85 of the 121 GB unified pool (~103 GB) is the thread's validated single-
# Spark figure. Do not raise: the remaining ~18 GB is what the host, the
# gateway, and the gamemakey containers live in.
GPU_MEMORY_UTILIZATION=0.85

# 262144, not the 1M default: 1M costs ~30 GB more KV and its semantic quality
# is unvalidated upstream, while 256k matches what the gateway's other
# backends advertise.
MAX_MODEL_LEN=262144

# EXTRA_VLLM_ARGS stays UNSET on purpose. Duplicating a flag the entrypoint
# already passes makes vLLM take the last occurrence, which is how other users
# silently lost the tool-call parser (raw DSML in output) -- thread known
# issue #2. Only add flags here that the entrypoint does not already set.
