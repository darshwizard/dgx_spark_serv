    "{\"method\": \"dflash\", \"model\": \"/workspace/models/Qwen3.8-27B-DFlash2\", \"num_speculative_tokens\": 7, \"draft_sample_method\": \"probabilistic\", \"rejection_sample_method\": \"standard\"}",
