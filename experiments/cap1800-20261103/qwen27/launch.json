{
  "command": [
    "/usr/bin/python3",
    "-m",
    "vllm.entrypoints.cli.main",
    "serve",
    "/workspace/models/Qwen3.8-27B-NVFP4",
    "--language-model-only",
    "--served-model-name",
    "candidate",
    "--host",
    "127.0.0.1",
    "--port",
    "8000",
    "--kv-cache-dtype",
    "fp8",
    "--max-model-len",
    "32768",
    "--max-num-seqs",
    "4",
    "--async-scheduling",
    "--enable-flashinfer-autotune",
    "--gpu-memory-utilization",
    "0.55",
    "--kernel-config",
    "{\"linear_backend\": \"nvfp4_dynamic\", \"nvfp4_dynamic_max_tokens\": 16, \"unquantized_linear_backend\": \"flashinfer_cudnn\", \"linear_backend_per_quant\": {\"fp8_w8a8\": \"cutlass\"}}",
    "--speculative-config",
    "{\"method\": \"dflash\", \"model\": \"/workspace/models/Qwen3.8-27B-DFlash2\", \"num_speculative_tokens\": 7, \"draft_sample_method\": \"probabilistic\", \"rejection_sample_method\": \"standard\"}",
    "--compilation-config",
    "{\"pass_config\": {\"fuse_act_quant\": true}, \"max_cudagraph_capture_size\": 64}",
    "--reasoning-parser",
    "qwen3",
    "--tool-call-parser",
    "qwen3_xml",
    "--enable-auto-tool-choice"
  ],
  "model": "qwen27",
  "environment": {
    "VLLM_VERSION": "0.31.0+88641915",
    "PYTORCH_TRITON_VERSION": "3.8.0+gitbd40f349.nv26.9",
    "VLLM_FLASH_ATTN_SRC_DIR": "/opt/vllm/vllm-flash-attn/",
    "VLLM_CACHE_ROOT": "/workspace/cache/playbook/vllm",
    "VLLM_SERVER_DEV_MODE": "1",
    "VLLM_NO_USAGE_STATS": "1",
    "OMP_NUM_THREADS": "8",
    "VLLM_USE_V2_MODEL_RUNNER": "1"
  },
  "queue_limits": {
    "memory_gib": 118,
    "cpus": 20,
    "shm_gib": 16
  },
  "thermal_stop_c": 90,
  "memory_stop_available_gib": 2
}