{
  "source": "experiments/qwen-standard-20261102/qwen-standard-02/launch.json",
  "command": [
    "/usr/bin/python3",
    "-m",
    "vllm.entrypoints.cli.main",
    "serve",
    "/workspace/models/Qwen3.8-27B-NVFP4",
    "--language-model-only",
    "--served-model-name",
    "qwen",
    "--host",
    "127.0.0.1",
    "--port",
    "8000",
    "--kv-cache-dtype",
    "fp8",
    "--max-model-len",
    "32768",
    "--max-num-seqs",
    "4",
    "--async-scheduling",
    "--enable-flashinfer-autotune",
    "--gpu-memory-utilization",
    "0.55",
    "--kernel-config",
    "{\"linear_backend\": \"nvfp4_dynamic\", \"nvfp4_dynamic_max_tokens\": 16, \"unquantized_linear_backend\": \"flashinfer_cudnn\", \"linear_backend_per_quant\": {\"fp8_w8a8\": \"cutlass\"}}",
    "--speculative-config",
    "{\"method\": \"dflash\", \"model\": \"/workspace/models/Qwen3.8-27B-DFlash2\", \"num_speculative_tokens\": 7, \"draft_sample_method\": \"probabilistic\", \"rejection_sample_method\": \"standard\"}",
    "--compilation-config",
    "{\"pass_config\": {\"fuse_act_quant\": true}, \"max_cudagraph_capture_size\": 64}",
    "--reasoning-parser",
    "qwen3",
    "--tool-call-parser",
    "qwen3_xml",
    "--enable-auto-tool-choice"
  ]
}
