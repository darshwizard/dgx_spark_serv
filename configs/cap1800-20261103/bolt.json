{
  "source": "experiments/bolt-standard-20261102/bolt-standard-01/launch.json",
  "command": [
    "/usr/bin/python3",
    "-m",
    "vllm.entrypoints.cli.main",
    "serve",
    "/workspace/models/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB",
    "--served-model-name",
    "bolt",
    "--host",
    "127.0.0.1",
    "--port",
    "8000",
    "--trust-remote-code",
    "--load-format",
    "instanttensor",
    "--tensor-parallel-size",
    "1",
    "--max-model-len",
    "32768",
    "--max-num-seqs",
    "4",
    "--gpu-memory-utilization",
    "0.55",
    "--enable-chunked-prefill",
    "--kv-cache-dtype",
    "fp8",
    "--block-size",
    "64",
    "--prefix-match-unit",
    "64",
    "--enable-mamba-shared-prefix-checkpoint",
    "--seed",
    "42",
    "--limit-mm-per-prompt",
    "{\"image\": 1, \"video\": 0}",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_coder",
    "--reasoning-parser",
    "nemotron_v3",
    "--speculative-config",
    "{\"method\": \"dflash\", \"model\": \"/workspace/models/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr\", \"num_speculative_tokens\": 7}",
    "--max-num-batched-tokens",
    "4096"
  ]
}
